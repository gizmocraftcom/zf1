{
    "name": "gizmocraft/zendframework1",
    "description": "Zend Framework 1",
    "type": "library",
    "keywords": [
        "framework",
        "zf1"
    ],
    "homepage": "http://framework.zend.com/",
    "license": "BSD-3-Clause",
    "prefer-stable": true,
    "minimum-stability": "dev",
    "require": {
        "gizmocraft/zendframework1-acl": "^2.0.0",
        "gizmocraft/zendframework1-application": "^2.0.0",
        "gizmocraft/zendframework1-auth": "^2.0.0",
        "gizmocraft/zendframework1-auth-adapter-dbtable": "^2.0.0",
        "gizmocraft/zendframework1-auth-adapter-http": "^2.0.0",
        "gizmocraft/zendframework1-auth-adapter-ldap": "^2.0.0",
        "gizmocraft/zendframework1-cache": "^2.0.0",
        "gizmocraft/zendframework1-captcha": "^2.0.0",
        "gizmocraft/zendframework1-config": "^3.0.0",
        "gizmocraft/zendframework1-controller": "^2.0.0",
        "gizmocraft/zendframework1-controller-action-helper-ajaxcontext": "^2.0.0",
        "gizmocraft/zendframework1-controller-action-helper-autocomplete": "^2.0.0",
        "gizmocraft/zendframework1-controller-action-helper-contextswitch": "^2.0.0",
        "gizmocraft/zendframework1-controller-action-helper-json": "^2.0.0",
        "gizmocraft/zendframework1-crypt": "^2.0.0",
        "gizmocraft/zendframework1-currency": "^2.0.0",
        "gizmocraft/zendframework1-date": "^2.0.0",
        "gizmocraft/zendframework1-db": "^2.0.0",
        "gizmocraft/zendframework1-dojo": "^2.0.0",
        "gizmocraft/zendframework1-dom": "^2.0.0",
        "gizmocraft/zendframework1-eventmanager": "^2.0.0",
        "gizmocraft/zendframework1-exception": "^2.0.0",
        "gizmocraft/zendframework1-file": "^2.0.0",
        "gizmocraft/zendframework1-filter": "^2.0.0",
        "gizmocraft/zendframework1-filter-input": "^2.0.0",
        "gizmocraft/zendframework1-form": "^2.0.0",
        "gizmocraft/zendframework1-http": "^2.0.0",
        "gizmocraft/zendframework1-json": "^2.0.0",
        "gizmocraft/zendframework1-layout": "^2.0.0",
        "gizmocraft/zendframework1-ldap": "^2.0.0",
        "gizmocraft/zendframework1-loader": "^2.0.0",
        "gizmocraft/zendframework1-locale": "^2.0.0",
        "gizmocraft/zendframework1-log": "^2.0.0",
        "gizmocraft/zendframework1-log-writer-db": "^2.0.0",
        "gizmocraft/zendframework1-log-writer-mail": "^2.0.0",
        "gizmocraft/zendframework1-mail": "^2.0.0",
        "gizmocraft/zendframework1-mime": "^2.0.0",
        "gizmocraft/zendframework1-navigation": "^2.0.0",
        "gizmocraft/zendframework1-oauth": "^2.0.0",
        "gizmocraft/zendframework1-paginator": "^2.0.0",
        "gizmocraft/zendframework1-progressbar": "^2.0.0",
        "gizmocraft/zendframework1-registry": "^2.0.0",
        "gizmocraft/zendframework1-rest": "^2.0.0",
        "gizmocraft/zendframework1-server": "^2.0.0",
        "gizmocraft/zendframework1-service": "^2.0.0",
        "gizmocraft/zendframework1-session": "^3.0.0",
        "gizmocraft/zendframework1-session-savehandler-dbtable": "^3.0.0",
        "gizmocraft/zendframework1-soap": "^3.0.0",
        "gizmocraft/zendframework1-stdlib": "^2.0.0",
        "gizmocraft/zendframework1-test": "^5.0.0",
        "gizmocraft/zendframework1-text": "^2.0.0",
        "gizmocraft/zendframework1-translate": "^2.0.0",
        "gizmocraft/zendframework1-uri": "^2.0.0",
        "gizmocraft/zendframework1-validate": "^2.0.1",
        "gizmocraft/zendframework1-validate-db": "^2.0.0",
        "gizmocraft/zendframework1-validate-file": "^2.0.0",
        "gizmocraft/zendframework1-validate-ldap": "^2.0.0",
        "gizmocraft/zendframework1-validate-sitemap": "^2.0.0",
        "gizmocraft/zendframework1-view": "^2.0.0",
        "gizmocraft/zendframework1-view-helper-action": "^2.0.0",
        "gizmocraft/zendframework1-view-helper-baseurl": "^2.0.0",
        "gizmocraft/zendframework1-view-helper-json": "^2.0.0",
        "gizmocraft/zendframework1-view-helper-layout": "^2.0.0",
        "gizmocraft/zendframework1-view-helper-navigation": "^2.0.0",
        "gizmocraft/zendframework1-view-helper-paginationcontrol": "^2.0.0",
        "gizmocraft/zendframework1-view-helper-partial": "^2.0.0",
        "gizmocraft/zendframework1-view-helper-url": "^2.0.0",
        "gizmocraft/zendframework1-xml": "^2.0.0",
        "php": ">=8.5"
    },
    "autoload": {
        "psr-0": {
            "Zend_Amf_": "library/",
            "Zend_Application_": "library/",
            "Zend_Barcode_": "library/",
            "Zend_Cloud_": "library/",
            "Zend_CodeGenerator_": "library/",
            "Zend_Console_": "library/",
            "Zend_Feed_": "library/",
            "Zend_Markup_": "library/",
            "Zend_Measure_": "library/",
            "Zend_Memory_": "library/",
            "Zend_Pdf_": "library/",
            "Zend_Queue_": "library/",
            "Zend_Reflection_": "library/",
            "Zend_Search_": "library/",
            "Zend_Serializer_": "library/",
            "Zend_Service_": "library/",
            "Zend_Tag_": "library/",
            "Zend_Tool_": "library/",
            "Zend_XmlRpc_": "library/"
        },
        "classmap": [
            "library/Zend/Barcode.php",
            "library/Zend/Debug.php",
            "library/Zend/Feed.php",
            "library/Zend/Markup.php",
            "library/Zend/Memory.php",
            "library/Zend/Pdf.php",
            "library/Zend/Queue.php",
            "library/Zend/Serializer.php",
            "library/Zend/Version.php"
        ]
    },
    "autoload-dev": {
        "psr-0": {
            "Zend_": "tests/"
        },
        "files": [
            "library/Zend/Service/WindowsAzure/CommandLine/Scaffolders/DefaultScaffolder/index.php",
            "tests/TestHelper.php"
        ]
    },
    "include-path": [
        "library/"
    ],
    "config": {
        "bin-dir": "bin"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4.8",
        "phpunit/phpcov": "^13.2.1",
        "phpstan/phpstan": "^2.3.7",
        "friendsofphp/php-cs-fixer": "^3.95.32"
    },
    "archive": {
        "exclude": [
            "/demos",
            "/documentation",
            "/tests"
        ]
    },
    "replace": {
        "zendframework/zendframework1": ">=1.12.20"
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=1024M -c phpstan.neon --ansi",
        "style-check": "php-cs-fixer fix --dry-run -vv"
    }
}
